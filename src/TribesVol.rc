#include <winver.h>

#ifndef TRIBESVOL_VER_MAJOR
#define TRIBESVOL_VER_MAJOR 1
#endif
#ifndef TRIBESVOL_VER_MINOR
#define TRIBESVOL_VER_MINOR 0
#endif
#ifndef TRIBESVOL_VER_PATCH
#define TRIBESVOL_VER_PATCH 0
#endif

#define STR_HELPER(x) #x
#define STR(x) STR_HELPER(x)
#define TRIBESVOL_VER_STR STR(TRIBESVOL_VER_MAJOR) "." STR(TRIBESVOL_VER_MINOR) "." STR(TRIBESVOL_VER_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TRIBESVOL_VER_MAJOR,TRIBESVOL_VER_MINOR,TRIBESVOL_VER_PATCH,0
 PRODUCTVERSION TRIBESVOL_VER_MAJOR,TRIBESVOL_VER_MINOR,TRIBESVOL_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tribes Community"
            VALUE "FileDescription", "7-Zip Format Plugin for Tribes 1 / DarkStar Volumes (.vol)"
            VALUE "FileVersion", TRIBESVOL_VER_STR
            VALUE "InternalName", "TribesVol"
            VALUE "OriginalFilename", "TribesVol.dll"
            VALUE "ProductName", "T1VolumesFor7z"
            VALUE "ProductVersion", TRIBESVOL_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
